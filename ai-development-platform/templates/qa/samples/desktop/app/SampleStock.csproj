<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SampleStock</AssemblyName>
    <RootNamespace>SampleStock</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Update="stock.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
