<Window x:Class="SampleStock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="在庫一覧" Height="420" Width="640">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" />
            </StatusBarItem>
        </StatusBar>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button x:Name="SaveButton" AutomationProperties.AutomationId="SaveButton"
                    Content="保存" Width="80" Margin="0,0,8,0" Click="OnSave" />
            <Button x:Name="DeleteButton" AutomationProperties.AutomationId="DeleteButton"
                    Content="削除" Width="80" Click="OnDelete" />
        </StackPanel>
        <DataGrid x:Name="StockGrid" AutomationProperties.AutomationId="StockGrid"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="品名" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="100" />
                <DataGridTextColumn Header="置き場所" Binding="{Binding Location}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
